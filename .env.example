# Fase 7G - plantilla de configuracion de despliegue.
#
# Copiar a `.env` y ajustar. NUNCA subir el `.env` con secretos al repositorio.
# Este fichero no contiene ninguna credencial real.

# --- Aplicacion ---------------------------------------------------------
# URL publica por la que se accede a la aplicacion. Es OBLIGATORIA fijarla en
# un despliegue real: de ella dependen dos cosas que fallan en silencio si se
# deja el valor de desarrollo.
#   1. Los enlaces de recuperacion de contrasena. Con el valor por defecto
#      apuntan a localhost:5173 y el correo llega con un enlace inservible.
#   2. La marca `Secure` de la cookie de sesion: se activa sola si la URL es
#      https.
PUBLIC_BASE_URL=http://localhost:8080

# --- Correo -------------------------------------------------------------
# 'console' imprime el enlace en el registro del servidor y NO envia nada.
# Es el modo de desarrollo y de pruebas. Para envio real: 'smtp'.
MAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@marimba.local

# --- Migracion 7C/7D ---------------------------------------------------
# Usuario NORMAL que hereda los proyectos historicos. Nunca un administrador.
MIGRATION_USER_EMAIL=migracion@marimba.local
# Si esta vacia NO se crea la cuenta ni se asignan los proyectos: es
# deliberado, para no inventar un propietario. Definela solo cuando vaya a
# ejecutarse la migracion, y no la dejes puesta en el despliegue.
MIGRATION_USER_PASSWORD=

# --- Primer administrador (Fase 7G) -------------------------------------
# El primer administrador NO se crea por variables de entorno ni por HTTP: se
# crea con la CLI, de forma explicita y una sola vez. Ver:
#   backend/app/cli.py -> `python -m app.cli create-admin --email ...`
