{
  "name": "marimba-organizer-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Cliente de escritorio de Marimba Organizer",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "electron": "^38.0.0"
  },
  "devDependencies": {
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.marimbaorganizer.desktop",
    "productName": "Marimba Organizer",
    "files": ["main.cjs", "preload.cjs"],
    "win": {"target": ["nsis"]},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true}
  }
}
